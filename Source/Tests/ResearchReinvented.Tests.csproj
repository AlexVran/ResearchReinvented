<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(RepositoryRoot)artifacts\tests\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Domain\**\*.cs" Link="Production\Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Opportunities\LegacyOpportunitySemantics.cs" Link="Production\LegacyOpportunitySemantics.cs" />
    <Compile Include="..\Utilities\ScopedServiceOverride.cs" Link="Production\ScopedServiceOverride.cs" />
    <None Include="..\..\tests\fixtures\**\*.json" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
